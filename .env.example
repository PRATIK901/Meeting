# Nothing here is required. The app runs with no configuration at all: its data
# is a SQLite file on this machine and there is no service to sign in to.
#
# Copy to `.env.local` only if you need one of these.

# Where the database file lives. Defaults to `server/../data/attendance.db`.
# Point it at a backed-up drive if you want the data somewhere else.
# DATA_DIR=D:\attendance-data

# Port the server listens on. Default 3000.
# PORT=3000

# The first administrator, created once on an empty database. If unset, the
# server creates `admin@local` / `changeme` and prints a warning. Change it
# afterwards with `npm run admin -- <email> <password>`.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-real-password

# The public origin the QR codes should encode.
# Leave unset and each code points at whatever origin the app is served from,
# which is what you want in normal use. Set it when you need to print or
# download codes for the office machine's address while developing elsewhere.
# VITE_PUBLIC_SITE_URL=http://192.168.1.50:3000
