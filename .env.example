# Local configuration. Copy to `.env.local` if you need any of it — with none
# of these set, the app runs against a local SQLite file exactly as before.

# ---------------------------------------------------------------------------
# Hosted database (Turso). Set these to point at the deployment's database,
# e.g. to run `npm run db:push` or `npm run admin` against it from here.
# On Vercel these are set in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://<name>-<org>.turso.io
# TURSO_AUTH_TOKEN=<from: turso db tokens create <name>>

# ---------------------------------------------------------------------------
# The office's timezone, which decides which calendar day a check-in lands on.
# Unset, this is UTC — correct only near Greenwich. Set it for the deployment:
# without it an evening check-in in India is filed under the following day.
# ---------------------------------------------------------------------------
# ATTENDANCE_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# The first administrator, created by `npm run db:push` when the database has
# no administrators. There is no default password: if these are unset, no
# account is created and you make one with `npm run admin`.
# ---------------------------------------------------------------------------
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-real-password

# Port the local server listens on. Default 3000.
# PORT=3000

# The public origin the QR codes should encode. Unset, each code points at
# whatever origin the app is served from — correct for the Vercel deployment.
# Set it only to print codes for a different origin than the one you are on.
# VITE_PUBLIC_SITE_URL=https://meeting-lac.vercel.app
